{
    "name": "ithilbert/module",
    "type": "library",
    "license": "MIT",
    "description": "Zum erstellen und verwalten von Modulen",
    "keywords": [
        "it-hilbert",
        "laravel",
        "homepage"
    ],
    "authors": [
        {
            "name": "Jörg Hilbert",
            "homepage": "https://www.it-hilbert.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://www.it-hilbert.com",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "doctrine/dbal": "^3.6 || ^4.0",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "ITHilbert\\Module\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ITHilbert\\Module\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ITHilbert\\Module\\ModuleServiceProvider"
            ],
            "aliases": {}
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    }
}
