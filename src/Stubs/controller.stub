<?php

declare(strict_types=1);

namespace Module\DummyModul\Controllers;

use Illuminate\Http\RedirectResponse;
use Illuminate\Routing\Controller;
use Illuminate\View\View;
use Module\DummyModul\Application\UseCases\DummyNameAnlegen;
use Module\DummyModul\Requests\StoreDummyNameRequest;
use Module\DummyModul\Requests\UpdateDummyNameRequest;

final class DummyModulController extends Controller
{
    public function __construct(
        private readonly DummyNameAnlegen $dummyNameAnlegen,
    ) {}

    public function index(): View
    {
        return view('dummyModul::index');
    }

    public function create(): View
    {
        return view('dummyModul::create');
    }

    public function store(StoreDummyNameRequest $request): RedirectResponse
    {
        $this->dummyNameAnlegen->execute();

        return redirect()->route('dummyModul.index')
            ->with('success', 'Eintrag erfolgreich angelegt.');
    }

    public function show(int $id): View
    {
        return view('dummyModul::show', compact('id'));
    }

    public function edit(int $id): View
    {
        return view('dummyModul::edit', compact('id'));
    }

    public function update(UpdateDummyNameRequest $request, int $id): RedirectResponse
    {
        // TODO: UpdateDummyName UseCase einbinden

        return redirect()->route('dummyModul.index')
            ->with('success', 'Eintrag erfolgreich aktualisiert.');
    }

    public function destroy(int $id): RedirectResponse
    {
        // TODO: DeleteDummyName UseCase einbinden

        return redirect()->route('dummyModul.index')
            ->with('success', 'Eintrag erfolgreich gelöscht.');
    }
}
